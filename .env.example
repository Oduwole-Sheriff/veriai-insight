# ---- Supabase (your own project) ----
# Found in your Supabase dashboard: Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Verification endpoint (optional) ----
# Leave empty to use the app's own same-origin server function (relative path).
# Set it to your deployed Supabase Edge Function to use that instead:
#   https://<your-project-ref>.supabase.co/functions/v1/verify
VITE_VERIFY_ENDPOINT=

# ---- Search provider (Tavily) ----
# Server-side / Edge Function secret name:
TAVILY_API_KEY=
# Only if you deliberately want the key in the browser bundle (not recommended):
VITE_TAVILY_API_KEY=

# ---- AI provider (choose ONE) ----
# openai | gemini | custom  (optional; auto-detected from the keys below)
AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Custom OpenAI-compatible gateway
AI_BASE_URL=
AI_API_KEY=
# Optional model override (defaults: gpt-4o-mini / gemini-2.0-flash)
AI_MODEL=

# Browser-exposed equivalents (only if you call providers from the client):
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
VITE_AI_BASE_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=

# ---- Offline mode ----
# Offline heuristic verification is OPT-IN. Set to "true" to allow it as a fallback.
VITE_ENABLE_OFFLINE_MODE=false
